{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sanitized system architecture and scoped executable acceptance",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "name": {
      "enum": [
        "AI_SOC",
        "AIZ_SOC"
      ]
    },
    "architecture": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "bringup": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "sources": {
      "type": "object",
      "properties": {
        "chipyard": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "opentitan": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "gem5": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "required": [
        "chipyard",
        "opentitan",
        "gem5"
      ],
      "additionalProperties": false
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "instance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "noc_endpoint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "instance",
          "provider",
          "model",
          "role",
          "noc_endpoint"
        ],
        "additionalProperties": false
      }
    },
    "noc": {
      "type": "object",
      "properties": {
        "engine": {
          "const": "garnet-standalone"
        },
        "topology": {
          "const": "Mesh_XY"
        },
        "mesh_rows": {
          "type": "integer"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "clock": {
          "const": "1GHz"
        },
        "simulation_ticks": {
          "type": "integer"
        },
        "injection_rate": {
          "type": "number"
        },
        "router_latency": {
          "type": "integer"
        },
        "link_latency": {
          "type": "integer"
        },
        "link_width_bits": {
          "type": "integer"
        },
        "vcs_per_vnet": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "required": [
        "engine",
        "topology",
        "mesh_rows",
        "endpoints",
        "clock",
        "simulation_ticks",
        "injection_rate",
        "router_latency",
        "link_latency",
        "link_width_bits",
        "vcs_per_vnet"
      ]
    },
    "asic": {
      "type": "object",
      "properties": {
        "flow": {
          "const": "openroad"
        },
        "pdk": {
          "enum": [
            "unselected",
            "nangate45",
            "sky130",
            "gf180",
            "external"
          ]
        },
        "noc_rtl": {
          "const": "constellation-candidate-unvalidated"
        }
      },
      "required": [
        "flow",
        "pdk",
        "noc_rtl"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "name",
    "architecture",
    "bringup",
    "sources",
    "blocks",
    "noc",
    "asic"
  ],
  "additionalProperties": false
}
