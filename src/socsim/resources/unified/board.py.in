# SPDX-License-Identifier: Apache-2.0
# Only validated generated contract values are accepted by the orchestrator.
import json
import sys
import m5
from m5.objects import (
    AddrRange, Clint, HiFiveBase, PMAChecker, Plic, RiscvBareMetal, RiscvRTC,
    RiscvTimingSimpleCPU, RiscvAtomicSimpleCPU, RiscvUart8250, Root, SimpleMemory, SrcClockDomain,
    System, SystemXBar, Terminal, UspBridge, VoltageDomain,
)
c = json.load(open(sys.argv[1]))
system = System()
system.voltage_domain = VoltageDomain()
system.clk_domain = SrcClockDomain(clock=str(c.get('cpu_clock_hz',1000000000))+'Hz', voltage_domain=system.voltage_domain)
system.mem_mode = c.get('mem_mode', 'timing')
system.mem_ranges = [AddrRange(c['ram_base'], size=c['ram_size'])]
system.mem = SimpleMemory(range=system.mem_ranges[0], latency='10ns',
                          image_file=c.get('ram_image', ''))
system.rom = SimpleMemory(range=AddrRange(c['rom_base'], size=c['rom_size']),
                          latency='10ns', writeable=False, image_file=c['rom_image'])
system.bus = SystemXBar()
system.system_port = system.bus.cpu_side_ports
system.mem.port = system.bus.mem_side_ports
system.rom.port = system.bus.mem_side_ports
cpu_type = {'RiscvTimingSimpleCPU': RiscvTimingSimpleCPU,
            'RiscvAtomicSimpleCPU': RiscvAtomicSimpleCPU}[c.get('cpu_model', 'RiscvTimingSimpleCPU')]
system.cpu = [cpu_type(cpu_id=0)]
cpu = system.cpu[0]
if system.mem_mode == 'atomic':
    cpu.simulate_data_stalls = True
    cpu.simulate_inst_stalls = True
cpu.icache_port = system.bus.cpu_side_ports
cpu.dcache_port = system.bus.cpu_side_ports
cpu.createInterruptController()
cpu.createThreads()
cpu.mmu.itb.walker.port = system.bus.cpu_side_ports
cpu.mmu.dtb.walker.port = system.bus.cpu_side_ports
system.platform = HiFiveBase(uart_int_id=c['uart_irq'])
p = system.platform
p.clint = Clint(pio_addr=c['clint_base'], num_threads=1,
                reset_mtimecmp=True, mtimecmp_reset_value=0xffffffffffffffff)
p.plic = Plic(pio_addr=c['plic_base'], n_src=c['plic_sources'], hart_config='MS')
p.rtc = RiscvRTC(frequency=str(c['timebase_hz'])+'Hz')
p.clint.int_pin = p.rtc.int_pin
p.terminal = Terminal(outfile='file')
p.uart = RiscvUart8250(pio_addr=c['uart_base'], platform=p, device=p.terminal)
system.bridge = UspBridge(socket_path=sys.argv[2], platform=p,
                         gcd_base=c['cygcd_base'], gpio_base=c['otgpio_base'],
                         finish_base=c['finisher_base'],
                         gcd_irq=c['cygcd_irq'], gpio_irq=c['otgpio_irq'])
for device in (p.clint, p.plic, p.uart, system.bridge):
    device.pio = system.bus.mem_side_ports
cpu.mmu.pma_checker = PMAChecker(uncacheable=[
    AddrRange(c[k+'_base'], size=c[k+'_size'])
    for k in ('clint', 'plic', 'uart', 'finisher', 'cygcd', 'otgpio')])
system.workload = RiscvBareMetal(bootloader=sys.argv[3], auto_reset_vect=False,
                                reset_vect=c['reset_vector'])
root = Root(full_system=True, system=system)
m5.instantiate()
event = m5.simulate(c['max_ticks'])
m5.stats.dump()
json.dump({'cause': event.getCause(), 'code': event.getCode(), 'tick': m5.curTick()},
          open(sys.argv[4], 'w'), indent=2)
