Import('*')
# Upstream EXTRAS adds these paths globally. Our generated SimObjects use
# absolute cxx_header paths; local C++ includes resolve beside their sources.
# Retain the base engine's native include command/dependency signatures.
extension = Dir('.').srcnode()
extension_paths = {extension.abspath, extension.Dir('..').abspath, Dir('.').abspath}
env['CPPPATH'] = [p for p in env['CPPPATH']
                  if getattr(p, 'abspath', None) not in extension_paths]
SimObject('UspBridge.py', sim_objects=['UspBridge'])
Source('usp_bridge.cc')
