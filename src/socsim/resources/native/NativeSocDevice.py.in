from m5.objects.Device import PioDevice
from m5.params import *

class NativeSocDevice(PioDevice):
    type = 'NativeSocDevice'
    cxx_class = 'gem5::NativeSocDevice'
    cxx_header = 'native_soc_device.hh'
    socket_path = Param.String('', 'Owned SystemC instance socket; empty for finisher')
    platform = Param.Platform('PLIC interrupt owner')
    base = Param.Addr('Declared physical base')
    span = Param.Addr('Declared aperture')
    kind = Param.Unsigned('0: Chipyard GCD/external; 1: OpenTitan GPIO; 2: finisher')
    irq = Param.Unsigned(0, 'PLIC source for this instance')
    pio_latency = Param.Latency('100ns', 'Uncalibrated model transaction latency')
    protocol = Param.String('usp-mmio32-v1', 'Wire contract: usp-mmio32-v1 or usp-bus-v2')
    quantum_ns = Param.Unsigned(0, 'Periodic quantum time sync period in ns (0 = disabled)')
    dma_enabled = Param.Bool(False, 'Allow usp-bus-v2 reverse bus-master DMA via System physProxy')
