/* Generated for the validated USP RV64 single-hart contract. */
#ifndef USP_FREERTOS_CONFIG_H
#define USP_FREERTOS_CONFIG_H

#define configUSE_PREEMPTION 1
#define configUSE_TIME_SLICING 1
#define configUSE_TICKLESS_IDLE 0
/* The upstream RISC-V port divides this value to program MTIME, not CPU cycles. */
#define configCPU_CLOCK_HZ $timebase_hz
#define configTICK_RATE_HZ 1000
#define configMTIME_BASE_ADDRESS $mtime
#define configMTIMECMP_BASE_ADDRESS $mtimecmp
#define configMAX_PRIORITIES 4
#define configMINIMAL_STACK_SIZE 256
#define configMAX_TASK_NAME_LEN 16
#define configTICK_TYPE_WIDTH_IN_BITS TICK_TYPE_WIDTH_64_BITS
#define configIDLE_SHOULD_YIELD 0
#define configSUPPORT_STATIC_ALLOCATION 1
#define configSUPPORT_DYNAMIC_ALLOCATION 0
#define configUSE_TIMERS 0
#define configUSE_MUTEXES 0
#define configUSE_RECURSIVE_MUTEXES 0
#define configUSE_COUNTING_SEMAPHORES 0
#define configQUEUE_REGISTRY_SIZE 0
#define configUSE_IDLE_HOOK 0
#define configUSE_TICK_HOOK 1
#define configUSE_TASK_NOTIFICATIONS 1
#define configCHECK_FOR_STACK_OVERFLOW 2
#define configISR_STACK_SIZE_WORDS 512
#define configUSE_PORT_OPTIMISED_TASK_SELECTION 0
#define INCLUDE_vTaskDelay 1
#define INCLUDE_vTaskSuspend 1
#define INCLUDE_xTaskGetSchedulerState 1

#ifndef __ASSEMBLER__
void usp_fail(void) __attribute__((noreturn));
void usp_switched_in(void);
#define configASSERT(x) do { if (!(x)) usp_fail(); } while (0)
#define traceTASK_SWITCHED_IN() usp_switched_in()
#endif
#endif
