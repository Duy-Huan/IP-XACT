#include <zephyr/kernel.h>
#include <zephyr/sys/printk.h>
#include <zephyr/sys/sys_io.h>
#include <zephyr/drivers/uart.h>
static K_SEM_DEFINE(timer_done, 0, 1);
static K_SEM_DEFINE(uart_done, 0, 1);
static void tick(struct k_timer *timer) {
    ARG_UNUSED(timer);
    if (k_is_in_isr()) { k_sem_give(&timer_done); }
}
K_TIMER_DEFINE(timer, tick, NULL);
static void uart_irq(const struct device *dev, void *data) {
    ARG_UNUSED(data);
    if (uart_irq_update(dev) && uart_irq_tx_ready(dev)) {
        uart_irq_tx_disable(dev);
        k_sem_give(&uart_done);
    }
}
$bridge_declarations
int main(void) {
    const struct device *uart = DEVICE_DT_GET(DT_CHOSEN(zephyr_console));
    printk("USP_ZEPHYR_BOOT_OK\n");
    k_timer_start(&timer, K_MSEC(20), K_NO_WAIT);
    if (k_sem_take(&timer_done, K_SECONDS(2))) { goto fail; }
    printk("USP_TIMER_IRQ_OK\n");
    if (uart_irq_callback_user_data_set(uart, uart_irq, NULL)) { goto fail; }
    uart_irq_tx_enable(uart);
    if (k_sem_take(&uart_done, K_SECONDS(2))) { goto fail; }
    printk("USP_UART_PLIC_IRQ_OK\n");
$bridge_test
    printk("USP_TEST_PASS\n");
    sys_write32(0x5555, $finisher_base);
    for (;;) { k_cpu_idle(); }
fail:
    printk("USP_TEST_FAIL\n");
    sys_write32(0x13333, $finisher_base);
    return 1;
}
