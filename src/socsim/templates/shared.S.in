/* Identical static RV64 Linux-ABI workload for QEMU/Linux and gem5 SE. */
.section .text
.globl _start
_start:
    li t0, 1000
    li t1, 0
1:
    add t1, t1, t0
    addi t0, t0, -1
    bnez t0, 1b
    li t2, 500500
    bne t1, t2, 2f
    li a0, 1
    la a1, passed
    li a2, 23
    li a7, 64
    ecall
    li a0, 0
    li a7, 93
    ecall
2:
    li a0, 1
    li a7, 93
    ecall
3:  j 3b
.section .rodata
passed: .ascii "USP_SHARED_WORKLOAD_OK\n"
