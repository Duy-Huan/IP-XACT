/* SPDX-License-Identifier: Apache-2.0 */
/* Generated from IR SHA256 $ir_hash. */
/dts-v1/;
/ {
    #address-cells = <1>;
    #size-cells = <1>;
    model = "USP generated RV64";
    compatible = "socsim,usp-rv64";
    chosen { zephyr,console = &uart0; zephyr,sram = &ram0; };
    $bridge_dts
    cpus {
        #address-cells = <1>; #size-cells = <0>;
        cpu@0 {
            device_type = "cpu"; reg = <0>; status = "okay";
            compatible = "qemu,riscv-virt", "riscv";
            riscv,isa = "rv64imac_zicsr_zifencei";
            hlic: interrupt-controller {
                compatible = "riscv,cpu-intc";
                #address-cells = <0>; #interrupt-cells = <1>; interrupt-controller;
            };
        };
    };
    ram0: memory@$ram_unit { device_type = "memory"; reg = <$ram_base $ram_size>; };
    uart0: uart@$uart_unit {
        compatible = "ns16550"; reg = <$uart_base $uart_size>;
        clock-frequency = <$uart_clock_hz>; current-speed = <115200>; reg-shift = <0>;
        interrupt-parent = <&plic>; interrupts = <$uart_irq 1>; status = "okay";
    };
    soc {
        compatible = "simple-bus"; #address-cells = <1>; #size-cells = <1>; ranges;
        plic: interrupt-controller@$plic_unit {
            compatible = "sifive,plic-1.0.0"; reg = <$plic_base $plic_size>;
            #address-cells = <0>; #interrupt-cells = <2>; interrupt-controller;
            riscv,max-priority = <7>; riscv,ndev = <31>;
            interrupts-extended = <&hlic 11 &hlic 9>;
        };
        clint: clint@$clint_unit {
            compatible = "sifive,clint0"; reg = <$clint_base $clint_size>;
            interrupts-extended = <&hlic 3 &hlic 7>;
        };
        mtimer: timer@$mtime_unit {
            compatible = "riscv,machine-timer";
            reg = <$mtime 8 $mtimecmp 8>; reg-names = "mtime", "mtimecmp";
            interrupts-extended = <&hlic 7>;
        };
    };
};
